# ==============================================================================
# ORÇA+ : GITIGNORE ROBUSTO (NEXT.JS + TYPESCRIPT + DEVOPS STANDARDS)
# ==============================================================================

# Dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Ambientes e Segredos (CRÍTICO: nunca versionar chaves reais)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Permitir versionamento explícito do arquivo modelo
!.env.example

# Next.js Build & Cache
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Testes e Cobertura
/coverage
*.lcov
.nyc_output

# Logs de depuração
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Vercel & Turbopack
.vercel
.turbo

# IDEs e Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Sistema Operacional (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Certificados & Chaves
*.pem
*.key
*.cert
*.crt

# Ferramentas de AI e ambientes locais
.agents/
.gemini/
